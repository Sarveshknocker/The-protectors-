# Copy to .env and fill in real values. NEVER commit .env.
# Generate strong secrets with:  openssl rand -base64 48
# Client-exposed variables (NEXT_PUBLIC_*, VITE_*, REACT_APP_*, PUBLIC_*) are visible to everyone — never put secrets in them.

NODE_ENV=development
PORT=3000

# Database (use a least-privilege user, not the superuser)
DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5432/app

# Sessions / tokens — at least 32 random characters
SESSION_SECRET=

# Comma-separated exact origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# Third-party integrations (server-side only)
STRIPE_SECRET_KEY=
SMTP_PASSWORD=

LOG_LEVEL=info
